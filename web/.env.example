# Deployed AgentSenate address on BNB Smart Chain (leave empty to see preview data)
NEXT_PUBLIC_SENATE_ADDRESS=
# Block number of the deployment transaction (BscScan tx page, "Block")
NEXT_PUBLIC_DEPLOY_BLOCK=
# Official Agent ID contract (copy from the campaign page)
NEXT_PUBLIC_AGENT_ID_ADDRESS=
# Your site URL, used in the agent guide, e.g. https://agent-senate.vercel.app
NEXT_PUBLIC_SITE_URL=
# Optional: a faster RPC, and max blocks per log request if your RPC limits ranges
NEXT_PUBLIC_RPC_URL=
LOG_CHUNK=5000

# --- Activity rewards ---
# Public address of the treasury wallet that pays rewards (holds the USDC). Safe to publish.
NEXT_PUBLIC_REWARD_TREASURY=
# Private key of that treasury wallet. SERVER ONLY. Use a dedicated wallet holding only the reward budget.
REWARD_PAYER_PRIVATE_KEY=
# Any long random string. Vercel Cron sends it so only the cron can trigger payouts.
CRON_SECRET=
# USDC token on BNB Chain. Defaults to Binance-Peg USDC; confirm on BscScan before funding.
REWARD_USDC_ADDRESS=
